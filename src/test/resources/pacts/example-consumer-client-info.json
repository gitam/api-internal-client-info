{
  "consumer": {
    "name": "example-consumer"
  },
  "interactions": [
    {
      "description": "a request for client C-1001",
      "key": "6705a71b",
      "pending": false,
      "providerStates": [
        {
          "name": "client C-1001 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/clients/C-1001"
      },
      "response": {
        "body": {
          "content": {
            "address": {
              "city": "London",
              "country": "GB"
            },
            "dateOfBirth": "1985-03-14",
            "email": "alice.morgan@example.com",
            "firstName": "Alice",
            "id": "C-1001",
            "lastName": "Morgan",
            "locked": false,
            "status": "ACTIVE"
          },
          "contentType": "application/json; charset=UTF-8",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=UTF-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.address.city": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.address.country": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.dateOfBirth": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\d{4}-\\d{2}-\\d{2}"
                }
              ]
            },
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.firstName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lastName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.locked": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "ACTIVE|SUSPENDED|CLOSED"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for an unknown client",
      "key": "9f89a11b",
      "pending": false,
      "providerStates": [
        {
          "name": "client C-9999 does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/clients/C-9999"
      },
      "response": {
        "body": {
          "content": {
            "status": 404
          },
          "contentType": "application/problem+json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/problem+json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/problem\\+json.*"
                }
              ]
            }
          }
        },
        "status": 404
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "client-info"
  }
}
